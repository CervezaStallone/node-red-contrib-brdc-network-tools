{
  "name": "node-red-contrib-network-tools",
  "version": "3.0.0",
  "description": "Comprehensive network monitoring, discovery, and diagnostic tools for Node-RED with Bonjour/mDNS, DNS, TCP port checking, traceroute, bandwidth, and SNMP support",
  "keywords": [
    "node-red",
    "ping",
    "network",
    "monitoring",
    "discovery",
    "performance",
    "ip",
    "subnet",
    "scanning",
    "bonjour",
    "mdns",
    "zeroconf",
    "service-discovery",
    "dns",
    "traceroute",
    "snmp",
    "port-scan",
    "bandwidth"
  ],
  "node-red": {
    "nodes": {
      "ping-ip": "ping-ip.js",
      "enhanced-ping": "enhanced-ping.js",
      "network-discovery": "network-discovery.js",
      "network-performance-monitor": "network-performance-monitor.js",
      "dns-lookup": "dns-lookup.js",
      "tcp-port-check": "tcp-port-check.js",
      "traceroute": "traceroute.js",
      "bandwidth-monitor": "bandwidth-monitor.js",
      "snmp-poll": "snmp-poll.js"
    }
  },
  "main": "ping-ip.js",
  "files": [
    "ping-ip.js",
    "ping-ip.html",
    "enhanced-ping.js",
    "enhanced-ping.html",
    "network-discovery.js",
    "network-discovery.html",
    "network-performance-monitor.js",
    "network-performance-monitor.html",
    "dns-lookup.js",
    "dns-lookup.html",
    "tcp-port-check.js",
    "tcp-port-check.html",
    "traceroute.js",
    "traceroute.html",
    "bandwidth-monitor.js",
    "bandwidth-monitor.html",
    "snmp-poll.js",
    "snmp-poll.html",
    "img/logo.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha test/**/*_spec.js",
    "test:watch": "mocha test/**/*_spec.js --watch",
    "test:verbose": "mocha test/**/*_spec.js --reporter spec",
    "pack-build": "npm pack --pack-destination ./build"
  },
  "author": "Brian Rodriguez - BRDC.nl",
  "license": "GPL-3.0-only",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/Cervezastalone"
  },
  "dependencies": {
    "bonjour": "3.5.0",
    "net-snmp": "3.26.3",
    "ping": "^0.4.4"
  },
  "devDependencies": {
    "mocha": "^11.7.6",
    "node-red": "^4.0.9",
    "node-red-node-test-helper": "^0.3.4",
    "should": "^13.2.3",
    "sinon": "^15.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CervezaStallone/node-red-contrib-brdc-network-tools.git"
  },
  "bugs": {
    "url": "https://github.com/CervezaStallone/node-red-contrib-brdc-network-tools/issues"
  },
  "homepage": "https://github.com/CervezaStallone/node-red-contrib-brdc-network-tools#readme"
}
